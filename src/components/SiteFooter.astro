---
const year = new Date().getFullYear();
---

<footer class="border-t-2 border-primary bg-[#151515]">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 py-14 lg:flex-row lg:justify-between lg:px-8">
    <img
      src="/images/ryba-logo.jpeg"
      alt="RYBA SpA — Equipos, arriendo, venta y servicios"
      width="480"
      height="320"
      class="h-24 w-auto rounded-sm ring-1 ring-background/10 object-contain"
    />
    <p class="text-center text-sm text-secondary lg:text-right">
      © {year} RYBA SpA. Todos los derechos reservados.
    </p>
  </div>
</footer>
