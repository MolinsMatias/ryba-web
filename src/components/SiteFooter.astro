---
import Instagram from "lucide-astro/Instagram";
import Linkedin from "lucide-astro/Linkedin";
import { WHATSAPP_NUMBER } from "@/lib/site";

const year = new Date().getFullYear();

const redesSociales = [
  {
    nombre: "Instagram",
    url: "https://www.instagram.com/ryba_2026/",
    icono: Instagram,
  },
  {
    nombre: "LinkedIn",
    url: "https://www.linkedin.com/in/rodrigo-ibarra-bustamante-447a4356/",
    icono: Linkedin,
  },
];
---

<footer
  class="w-full border-t-2 border-primary bg-[#151515] text-background py-8 lg:py-10 mt-0"
>
  <div
    class="mx-auto max-w-6xl px-6 lg:px-8 flex flex-col md:flex-row justify-between items-start gap-12"
  >
    <div class="flex flex-col gap-5 max-w-sm">
      <div class="flex items-center gap-3.5">
        <img
          src="/images/ryba-logo-circular.webp"
          alt="Logo RYBA SpA"
          width="48"
          height="48"
          class="size-11 rounded-full ring-1 ring-primary/40 object-cover"
        />
        <span
          class="font-display text-2xl font-bold tracking-widest text-background uppercase"
        >
          RYBA Equipos
        </span>
      </div>
      <p class="text-sm leading-relaxed text-secondary/70 text-pretty">
        Soluciones integrales en arriendo, venta y mantenimiento de equipos para
        construcción, minería e industria.
      </p>
    </div>

    <div class="flex flex-col gap-4">
      <span
        class="font-display text-sm tracking-[0.22em] text-primary uppercase font-bold"
      >
        Contacto
      </span>
      <div
        class="flex flex-col gap-2 text-sm text-secondary/80 leading-relaxed"
      >
        <a
          href="mailto:ryba.spa@gmail.com"
          class="transition-colors hover:text-primary"
        >
          ryba.spa@gmail.com
        </a>
        <a
          href={`https://wa.me/${WHATSAPP_NUMBER}`}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-primary"
        >
          +56 9 5206 3672
        </a>
        <span class="text-secondary/60">
          Santiago · Cobertura en todo Chile
        </span>
      </div>
    </div>

    <div class="flex flex-col gap-6 md:items-end">
      <div class="flex flex-col md:items-end gap-3">
        <span
          class="font-display text-xs tracking-widest text-secondary/60 uppercase"
        >
          Síguenos
        </span>
        <div class="flex gap-3">
          {
            redesSociales.map((red) => {
              const Icono = red.icono;
              return (
                <a
                  href={red.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Visitar ${red.nombre} de RYBA Equipos`}
                  class="size-11 border border-white/20 bg-[#1e1e1e] flex items-center justify-center text-secondary transition-all duration-300 hover:bg-primary hover:border-primary hover:text-primary-foreground hover:-translate-y-1 hover:shadow-lg group"
                >
                  <Icono
                    class="size-5 transition-transform group-hover:scale-110"
                    stroke-width={1.75}
                    aria-hidden="true"
                  />
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>

  <div
    class="mx-auto max-w-6xl px-6 lg:px-8 mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-secondary/60"
  >
    <p class="text-secondary/50 text-center sm:text-left">
      © {year} RYBA SpA. Todos los derechos reservados.
    </p>

    <div class="footer-watermark">
      <p>
        Diseñado y desarrollado por
        <a
          href="mailto:m.molins03@gmail.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hevstack-link"
        >
          <svg
            class="hevstack-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            width="14"
            height="14"
          >
            <path
              d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Matias Molins
        </a>
        — <a
          href="mailto:m.molins03@gmail.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hevstack-cta"
        >
          ¿Quieres tu propia web?
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-watermark {
    font-size: 0.75rem;
    color: rgba(196, 196, 196, 0.45);
    opacity: 0.55;
    transition: opacity 0.25s ease;
  }

  .footer-watermark:hover {
    opacity: 0.95;
  }

  .footer-watermark p {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    line-height: 1.5;
  }

  .hevstack-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: rgba(196, 196, 196, 0.7);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hevstack-link:hover {
    color: var(--primary);
  }

  .hevstack-icon {
    display: inline-block;
    color: currentColor;
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .hevstack-link:hover .hevstack-icon {
    color: var(--primary);
    transform: scale(1.15);
  }

  .hevstack-cta {
    color: rgba(243, 166, 0, 0.75);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .hevstack-cta:hover {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
