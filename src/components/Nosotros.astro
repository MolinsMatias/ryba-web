---
import Target from "lucide-astro/Target";
import Eye from "lucide-astro/Eye";
import ShieldCheck from "lucide-astro/ShieldCheck";
import Award from "lucide-astro/Award";
import Clock from "lucide-astro/Clock";
import { empresa } from "@/lib/site";

const pilares = [
  {
    icono: ShieldCheck,
    titulo: "Equipos Confiables",
    descripcion: "Mantención rigurosa para operar sin interrupciones.",
  },
  {
    icono: Award,
    titulo: "Atención Personalizada",
    descripcion: "Asesoría técnica a la medida de tu proyecto.",
  },
  {
    icono: Clock,
    titulo: "Respuesta Oportuna",
    descripcion: "Disponibilidad y traslado ágil a faena.",
  },
];
---

<section
  id="nosotros"
  aria-labelledby="nosotros-titulo"
  class="scroll-mt-6 border-b border-border bg-card"
>
  <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-24">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <div class="flex items-center gap-3">
          <span aria-hidden="true" class="h-0.5 w-10 bg-primary"></span>
          <span class="font-display text-sm tracking-[0.22em] text-muted-foreground uppercase">
            Sobre RYBA SpA
          </span>
        </div>
        <h2
          id="nosotros-titulo"
          class="mt-4 font-display text-4xl leading-none font-bold tracking-tight text-foreground uppercase sm:text-5xl"
        >
          Misión y Visión
        </h2>
      </div>
      <p class="max-w-md text-base leading-relaxed text-muted-foreground text-pretty">
        El compromiso estratégico que guía cada arriendo, venta y servicio en terreno.
      </p>
    </div>

    <!-- Bloques Misión y Visión -->
    <div class="mt-14 grid gap-8 md:grid-cols-2">
      <!-- Misión -->
      <div class="group relative flex flex-col justify-between border border-border bg-background p-8 transition-shadow hover:shadow-lg lg:p-10">
        <span
          aria-hidden="true"
          class="absolute inset-x-0 top-0 h-1 bg-primary"
        ></span>
        <div>
          <div class="flex items-center gap-4">
            <div class="flex size-12 items-center justify-center rounded-sm bg-primary/10 text-primary">
              <Target class="size-6" stroke-width={2} aria-hidden="true" />
            </div>
            <h3 class="font-display text-3xl font-bold tracking-wide text-foreground uppercase">
              Misión
            </h3>
          </div>
          <p class="mt-6 text-base leading-relaxed text-muted-foreground text-pretty">
            {empresa.mision}
          </p>
        </div>
      </div>

      <!-- Visión -->
      <div class="group relative flex flex-col justify-between border border-border bg-background p-8 transition-shadow hover:shadow-lg lg:p-10">
        <span
          aria-hidden="true"
          class="absolute inset-x-0 top-0 h-1 bg-primary"
        ></span>
        <div>
          <div class="flex items-center gap-4">
            <div class="flex size-12 items-center justify-center rounded-sm bg-primary/10 text-primary">
              <Eye class="size-6" stroke-width={2} aria-hidden="true" />
            </div>
            <h3 class="font-display text-3xl font-bold tracking-wide text-foreground uppercase">
              Visión
            </h3>
          </div>
          <p class="mt-6 text-base leading-relaxed text-muted-foreground text-pretty">
            {empresa.vision}
          </p>
        </div>
      </div>
    </div>

    <!-- Pilares de valor -->
    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      {pilares.map((pilar) => {
        const Icono = pilar.icono;
        return (
          <div class="flex items-start gap-4 border border-border/80 bg-background/50 p-5">
            <Icono class="size-5 shrink-0 text-primary mt-0.5" stroke-width={2} aria-hidden="true" />
            <div>
              <h4 class="font-display text-base font-bold tracking-wide text-foreground uppercase">
                {pilar.titulo}
              </h4>
              <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                {pilar.descripcion}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
