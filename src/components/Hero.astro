---
import WhatsAppCta from "@/components/WhatsAppCta.astro";

const garantias = [
  "Equipos con mantención al día",
  "Operadores certificados",
  "Cobertura en todo Chile",
];
---

<section id="inicio" class="relative isolate overflow-hidden bg-[#151515]">
  <img
    src="/images/hero-maquinaria.png"
    alt="Excavadora y cargador frontal trabajando en una faena de movimiento de tierra"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover object-center opacity-40"
  />
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-linear-to-r from-[#151515] via-[#151515]/85 to-[#151515]/30"
  >
  </div>

  <div class="relative mx-auto flex min-h-168 max-w-6xl flex-col px-6 lg:px-8">
    <!-- Barra superior con identidad -->
    <header class="flex items-center gap-4 py-6">
      <img
        src="/images/ryba-logo-circular.jpeg"
        alt="Logo de RYBA SpA"
        width="56"
        height="56"
        class="size-14 rounded-full ring-1 ring-primary/40 object-cover"
      />
      <div class="flex flex-col">
        <span
          class="font-display text-xl leading-none font-bold tracking-widest text-background uppercase"
        >
          RYBA SpA
        </span>
        <span
          class="mt-1 text-[0.7rem] tracking-[0.18em] text-secondary uppercase"
        >
          Maquinaria confiable para proyectos rentables.
        </span>
      </div>
      <nav
        class="ml-auto hidden items-center gap-6 font-display text-sm tracking-widest text-secondary uppercase sm:flex"
      >
        <a href="#servicios" class="transition-colors hover:text-primary">
          Servicios
        </a>
        <a href="#nosotros" class="transition-colors hover:text-primary">
          Nosotros
        </a>
        <a href="#catalogo" class="transition-colors hover:text-primary">
          Catálogo
        </a>
      </nav>
    </header>

    <div class="flex flex-1 flex-col justify-center py-16 lg:py-24">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="h-0.5 w-10 bg-primary"></span>
        <span
          class="font-display text-sm tracking-[0.22em] text-primary uppercase"
        >
          Arriendo de maquinaria pesada
        </span>
      </div>

      <h1
        class="mt-6 max-w-3xl font-display text-5xl leading-[0.95] font-bold tracking-tight text-balance text-background uppercase sm:text-6xl lg:text-7xl"
      >
        Maquinaria pesada operativa, en faena cuando la necesitas
      </h1>

      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-secondary text-pretty"
      >
        Flota propia con respaldo técnico, traslado incluido y operadores
        certificados para minería, construcción e industria.
      </p>

      <div class="mt-10">
        <WhatsAppCta
          mensaje="Hola RYBA SpA, necesito cotizar el arriendo de maquinaria. ¿Me pueden ayudar?"
        />
      </div>
    </div>

    <ul
      class="flex flex-col gap-3 border-t border-background/15 py-6 text-sm text-secondary sm:flex-row sm:items-center sm:gap-8"
    >
      {
        garantias.map((item) => (
          <li class="flex items-center gap-2.5">
            <span aria-hidden="true" class="size-1.5 shrink-0 bg-primary" />
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
