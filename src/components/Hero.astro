---
import WhatsAppCta from "@/components/WhatsAppCta.astro";

const garantias = [
  "Equipos con mantención al día",
  "Soporte técnico en terreno",
  "Cobertura en todo Chile",
];
---

<section id="inicio" class="relative isolate overflow-hidden bg-[#151515]">
  <img
    src="/images/hero-maquinaria.webp"
    alt="Equipos de respaldo energético, izaje e infraestructura en terreno"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover object-center opacity-40"
  />
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-linear-to-r from-[#151515] via-[#151515]/85 to-[#151515]/30"
  >
  </div>

  <div
    class="relative mx-auto flex min-h-screen max-w-6xl flex-col justify-between px-6 pt-28 pb-8 sm:pt-32 md:pt-36 lg:px-8 lg:pt-36"
  >
    <div class="flex flex-1 flex-col justify-center py-8 lg:py-16">
      <!-- Kicker -->
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="h-0.5 w-8 bg-primary"></span>
        <span
          class="font-display text-sm tracking-[0.25em] text-primary uppercase font-semibold"
        >
          Venta y arriendo de equipos
        </span>
      </div>

      <!-- Headline: EQUIPOS OPERATIVOS, EN FAENA CUANDO LOS NECESITAS -->
      <h1
        class="mt-6 max-w-3xl font-display text-5xl leading-[0.92] font-bold tracking-tight text-background uppercase sm:text-6xl lg:text-7xl"
      >
        Equipos operativos<br class="hidden sm:inline" />
        en faena cuando<br class="hidden sm:inline" />
        los necesitas
      </h1>

      <!-- Texto descriptivo -->
      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-secondary text-pretty"
      >
        Soluciones en respaldo energético, izaje e infraestructura con soporte
        técnico en terreno y logística para minería, construcción e industria.
      </p>

      <!-- Botón CTA principal de WhatsApp -->
      <div class="mt-10">
        <WhatsAppCta
          mensaje="Hola Rodrigo, me interesa cotizar equipos para faena (venta / arriendo). ¿Me pueden asesorar?"
          label="Cotizar por WhatsApp"
        />
      </div>
    </div>

    <!-- Barra de Confianza Responsiva en Lista Nativa -->
    <ul
      class="flex flex-col gap-3 border-t border-background/15 py-6 text-sm text-secondary md:flex-row md:items-center md:gap-8"
    >
      {
        garantias.map((item) => (
          <li class="flex items-center gap-2.5">
            <span aria-hidden="true" class="size-1.5 shrink-0 bg-primary" />
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
