---
import { cn } from "@/lib/utils";
import { whatsappLink } from "@/lib/site";

interface Props {
  mensaje: string;
  variant?: "primary" | "secondary";
  label?: string;
  class?: string;
}

const {
  mensaje,
  variant = "primary",
  label = "Cotizar por WhatsApp",
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={whatsappLink(mensaje)}
  target="_blank"
  rel="noopener noreferrer"
  class={cn(
    "group inline-flex items-center justify-center gap-2.5 font-display font-semibold tracking-wide uppercase transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
    variant === "primary" &&
      "h-14 rounded-sm bg-primary px-8 text-lg text-primary-foreground hover:bg-primary/85",
    variant === "secondary" &&
      "h-11 w-full rounded-sm border border-foreground/15 bg-foreground px-5 text-sm text-background hover:border-primary hover:bg-primary hover:text-primary-foreground",
    className
  )}
  {...rest}
>
  <svg
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    class={variant === "primary" ? "size-5 shrink-0" : "size-4 shrink-0"}
  >
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38c1.45.79 3.08 1.2 4.79 1.2h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01c-1.5 0-2.97-.4-4.26-1.17l-.3-.18-3.12.82.83-3.04-.2-.31a8.24 8.24 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.41a8.16 8.16 0 0 1 2.41 5.83c0 4.54-3.7 8.25-8.16 8.25Zm4.53-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.06-.39-2.02-1.25-.75-.66-1.25-1.48-1.39-1.73-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.42.06-.64.31-.22.25-.85.83-.85 2.02 0 1.19.87 2.34.99 2.5.12.17 1.7 2.6 4.12 3.64.58.25 1.02.4 1.37.51.58.19 1.1.16 1.52.1.46-.07 1.47-.6 1.68-1.19.21-.58.21-1.08.15-1.19-.06-.1-.23-.16-.48-.29Z"
    ></path>
  </svg>
  <span>{label}</span>
</a>
