---
import Eye from "lucide-astro/Eye";
import ModalDetalleProducto, {
  type ProductoModal,
} from "./ModalDetalleProducto.astro";

// Número de WhatsApp para cotizaciones (formato internacional sin "+")
const telefono = "56952063672";

// ─── Catálogo Real: 4 Equipos RYBA SpA ─────────────────────────────────────

const generadorElectrico: ProductoModal = {
  id: "generador-electrico",
  nombre: "Generador Eléctrico",
  descripcion_corta:
    "Respaldo de energía insonorizado para faenas y obras. Disponibilidad inmediata y energía continua en terreno.",
  modalidad: "Arriendo",
  imagenes: [
    "/images/catalogo/generador-electrico/generador-rojo.webp",
    "/images/catalogo/generador-electrico/generador-rojo-lateral.webp",
    "/images/catalogo/generador-electrico/generador-azul1.webp",
    "/images/catalogo/generador-electrico/generador-azul2.webp",
  ],
  especificaciones: [
    { label: "Unidades disponibles", valor: "3", icono: "capacidad" },
    {
      label: "Ventaja",
      valor: "Energía continua en terreno",
      icono: "potencia",
    },
  ],
  disponibilidad: {
    estado: "Disponible para arriendo",
    detalle: "3 unidades en stock - Listo para trabajar",
  },
};

const gruaHidraulica: ProductoModal = {
  id: "grua-hidraulica",
  nombre: "Grúas Hidráulicas Tipo Pluma",
  descripcion_corta:
    "Capacidades de 500kg, 1.000kg y 2.000kg. Montaje rápido y directo sobre camiones o camionetas de 5T.",
  modalidad: "Venta",
  imagenes: [
    "/images/catalogo/grua-hidraulica/foto-de-portada.webp",
    "/images/catalogo/grua-hidraulica/foto-de-contexto-estilo-de-vida.webp",
    "/images/catalogo/grua-hidraulica/foto-de-detalle-close-up-tecnica.webp",
    "/images/catalogo/grua-hidraulica/foto-de-escala-o-dimensiones.webp",
    "/images/catalogo/grua-hidraulica/foto-de-funcionalidad.webp",
    "/images/catalogo/grua-hidraulica/foto-en-camioneta.webp",
    "/images/catalogo/grua-hidraulica/foto-en-camioneta-1.webp",
    "/images/catalogo/grua-hidraulica/foto-en-camioneta-2.webp",
    "/images/catalogo/grua-hidraulica/detalle-de-montaje-y-base-chico.webp",
    "/images/catalogo/grua-hidraulica/detalle-de-montaje-y-base-grande.webp",
    "/images/catalogo/grua-hidraulica/detalle-de-winche-y-cabezal-de-pluma.webp",
    "/images/catalogo/grua-hidraulica/perspectiva-alternativa-vista-completa.webp",
  ],
  especificaciones: [
    {
      label: "Capacidad",
      valor: "500 / 1.000 / 2.000 kg",
      icono: "capacidad",
    },
    {
      label: "Montaje",
      valor: "Directo sobre camiones o camionetas de 5T",
      icono: "montaje",
    },
  ],
  disponibilidad: {
    estado: "Disponible para venta",
    detalle: "En stock - Entrega inmediata",
  },
};

const torreIluminacionSolar: ProductoModal = {
  id: "torre-iluminacion-solar",
  nombre: "Torre de Iluminación Solar",
  descripcion_corta:
    "Mástil retráctil de 7 metros movible en 360°. Ahorro anual de $7.560.000 en diésel y retorno en 12 meses.",
  modalidad: "Venta y Arriendo",
  imagenes: [
    "/images/catalogo/torre-iluminacion-solar/titulo-vision-frontal-y-producto-heroe.webp",
    "/images/catalogo/torre-iluminacion-solar/contexto-de-uso-y-preparacion.webp",
    "/images/catalogo/torre-iluminacion-solar/demostracion-de-poder-y-funcionalidad.webp",
    "/images/catalogo/torre-iluminacion-solar/detalle-tecnico-y-panel-de-control.webp",
    "/images/catalogo/torre-iluminacion-solar/perfil-de-despliegue-y-dimensiones.webp",
    "/images/catalogo/torre-iluminacion-solar/rendimiento-y-cobertura-de-area.webp",
    "/images/catalogo/torre-iluminacion-solar/whatsapp-image-2026-09-04-at-115830-3.webp",
  ],
  especificaciones: [
    { label: "Autonomía", valor: "36 horas", icono: "autonomia" },
    {
      label: "Ahorro anual en diésel",
      valor: "$7.560.000",
      icono: "ahorro",
    },
    { label: "Retorno de inversión", valor: "12 meses", icono: "ahorro" },
    {
      label: "Certificaciones",
      valor: "IP66, IK10, SEC, IEC 61439",
      icono: "certificacion",
    },
  ],
  disponibilidad: {
    estado: "Disponible para venta y arriendo",
    detalle: "En stock - Listo para trabajar",
  },
};

const modularSolarRoof: ProductoModal = {
  id: "modular-solar-roof",
  nombre: "Techo para Contenedor",
  descripcion_corta:
    "Estructura modular para contenedores de 20 o 40 pies con fijación twist-lock. Ahorro anual de $18.396.000 en diésel y $0 en mantención.",
  modalidad: "Venta y Arriendo",
  imagenes: [
    "/images/catalogo/modular-solar-roof/producto-heroe-vision-final-de-la-solucion-portada.webp",
    "/images/catalogo/modular-solar-roof/detalle-posterior-y-accesos.webp",
    "/images/catalogo/modular-solar-roof/escala-y-dimensiones-laterales.webp",
    "/images/catalogo/modular-solar-roof/funcionalidad-tecnica-sistema-energetico-integrado.webp",
  ],
  especificaciones: [
    { label: "Autonomía", valor: "24 horas", icono: "autonomia" },
    {
      label: "Ahorro anual en diésel",
      valor: "$18.396.000",
      icono: "ahorro",
    },
    { label: "Costo mantención", valor: "$0", icono: "ahorro" },
    {
      label: "Certificaciones",
      valor: "IP67, IK10, SEC, IEC 61439",
      icono: "certificacion",
    },
  ],
  disponibilidad: {
    estado: "Disponible para venta y arriendo",
    detalle: "En stock - Listo para trabajar",
  },
};

// Array final para iterar en la grilla y pasar al modal
const maquinaria: ProductoModal[] = [
  generadorElectrico,
  gruaHidraulica,
  torreIluminacionSolar,
  modularSolarRoof,
];
---

<section
  id="catalogo"
  aria-labelledby="catalogo-titulo"
  class="border-b border-border bg-background"
>
  <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-24">
    <div
      class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
    >
      <div>
        <div class="flex items-center gap-3">
          <span aria-hidden="true" class="h-0.5 w-10 bg-primary"></span>
          <span
            class="font-display text-sm tracking-[0.22em] text-muted-foreground uppercase"
          >
            Disponibilidad inmediata
          </span>
        </div>
        <h2
          id="catalogo-titulo"
          class="mt-4 font-display text-4xl leading-none font-bold tracking-tight text-foreground uppercase sm:text-5xl"
        >
          Catálogo de equipos
        </h2>
      </div>
      <p
        class="max-w-md text-base leading-relaxed text-muted-foreground text-pretty"
      >
        Selecciona el equipo y te enviamos valor por día, semana o mes junto a
        las condiciones de traslado.
      </p>
    </div>

    <!-- Grilla 2×2 del Catálogo Real -->
    <ul class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        maquinaria.map((equipo) => (
          <li class="group flex flex-col border border-border bg-card transition-shadow hover:shadow-[0_18px_40px_-24px_rgba(21,21,21,0.35)]">
            {/* Foto de portada del equipo */}
            <div class="relative flex items-center justify-center aspect-4/3 w-full overflow-hidden border-b border-border bg-neutral-100/70 p-4">
              <img
                src={equipo.imagenes?.[0] ?? ""}
                alt={equipo.nombre}
                class="h-full w-full object-contain object-center transition-transform duration-500 group-hover:scale-105 drop-shadow-sm"
                loading="lazy"
                decoding="async"
              />

              {/* Badge de modalidad sobre la foto */}
              {equipo.modalidad && (
                <span class="absolute top-4 left-4 rounded-sm bg-foreground/85 px-3 py-1 font-display text-[11px] font-semibold tracking-wider text-background uppercase backdrop-blur-sm">
                  {equipo.modalidad}
                </span>
              )}
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-display text-2xl leading-none font-semibold tracking-wide text-foreground uppercase">
                {equipo.nombre}
              </h3>

              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                {equipo.descripcion_corta}
              </p>

              <div class="mt-6 flex-1" />

              {/* Botón de WhatsApp Inteligente */}
              <a
                href={`https://wa.me/${telefono}?text=Hola,%20me%20interesa%20cotizar%20el%20${encodeURIComponent(equipo.nombre)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex h-11 w-full items-center justify-center gap-2.5 rounded-sm border border-foreground/15 bg-foreground px-5 font-display text-sm font-semibold tracking-wide text-background uppercase transition-colors hover:border-primary hover:bg-primary hover:text-primary-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  class="size-4 shrink-0 transition-transform group-hover:scale-110"
                >
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38c1.45.79 3.08 1.2 4.79 1.2h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01c-1.5 0-2.97-.4-4.26-1.17l-.3-.18-3.12.82.83-3.04-.2-.31a8.24 8.24 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.41a8.16 8.16 0 0 1 2.41 5.83c0 4.54-3.7 8.25-8.16 8.25Zm4.53-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.06-.39-2.02-1.25-.75-.66-1.25-1.48-1.39-1.73-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.42.06-.64.31-.22.25-.85.83-.85 2.02 0 1.19.87 2.34.99 2.5.12.17 1.7 2.6 4.12 3.64.58.25 1.02.4 1.37.51.58.19 1.1.16 1.52.1.46-.07 1.47-.6 1.68-1.19.21-.58.21-1.08.15-1.19-.06-.1-.23-.16-.48-.29Z" />
                </svg>
                <span>Cotizar por WhatsApp</span>
              </a>

              {/* Botón Ver Detalle */}
              <button
                type="button"
                aria-label={`Ver detalle de ${equipo.nombre}`}
                aria-haspopup="dialog"
                data-open-modal={equipo.id}
                data-producto-id={equipo.id}
                class="group mt-2.5 inline-flex h-11 w-full cursor-pointer items-center justify-center gap-2.5 rounded-sm border border-foreground bg-white px-5 font-display text-sm font-semibold tracking-wide text-foreground uppercase transition-all hover:bg-foreground hover:text-background focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-[0.99]"
              >
                <Eye
                  class="size-4 shrink-0 transition-transform group-hover:scale-110"
                  aria-hidden="true"
                />
                <span>Ver detalle</span>
              </button>
            </div>
          </li>
        ))
      }
    </ul>

    {/* Componente Modal de Detalle de Producto */}
    <ModalDetalleProducto maquinaria={maquinaria} telefono={telefono} />
  </div>
</section>
