---
import Eye from "lucide-astro/Eye";
import Zap from "lucide-astro/Zap";
import Check from "lucide-astro/Check";
import {
  catalogo,
  WHATSAPP_NUMBER,
  whatsappLink,
  type Equipo,
} from "@/lib/site";
import ModalDetalleProducto from "./ModalDetalleProducto.astro";

// Estilo plano estático unificado para etiquetas de modalidad
const BADGE_MODALIDAD_CLASS = "bg-neutral-900 text-white border-neutral-800";
---

<section
  id="catalogo"
  aria-labelledby="catalogo-titulo"
  class="border-b border-border bg-background"
>
  <div class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-24">
    <div
      class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
    >
      <div>
        <div class="flex items-center gap-3">
          <span aria-hidden="true" class="h-0.5 w-10 bg-primary"></span>
          <span
            class="font-display text-sm tracking-[0.22em] text-muted-foreground uppercase font-semibold"
          >
            Disponibilidad inmediata
          </span>
        </div>
        <h2
          id="catalogo-titulo"
          class="mt-4 font-display text-4xl leading-none font-bold tracking-tight text-foreground uppercase sm:text-5xl"
        >
          Catálogo de equipos
        </h2>
      </div>
      <p
        class="max-w-md text-base leading-relaxed text-muted-foreground text-pretty"
      >
        Equipos de respaldo energético, izaje y soluciones modulares para la
        construcción. Cotización directa a WhatsApp.
      </p>
    </div>

    <ul class="mt-12 grid gap-6 sm:gap-8 sm:grid-cols-2">
      {
        catalogo.map((equipo: Equipo) => (
          <li class="group relative flex flex-col rounded-lg border border-neutral-200/90 bg-card shadow-xs transition-all duration-300 hover:border-neutral-400 hover:shadow-lg overflow-hidden">
            <button
              type="button"
              data-open-modal={equipo.id}
              data-producto-id={equipo.id}
              data-trigger-type="photo"
              aria-label={`Ver fotos y especificaciones de ${equipo.nombre}`}
              tabindex="-1"
              class="group/photo relative flex items-center justify-center aspect-4/3 w-full overflow-hidden border-b border-neutral-200/90 bg-neutral-100/80 p-4 select-none cursor-pointer outline-none focus:outline-none focus:ring-0 focus-visible:outline-none active:outline-none active:ring-0 [-webkit-tap-highlight-color:transparent]"
              style="outline: none !important; box-shadow: none !important;"
            >
              <img
                src={equipo.imagenes?.[0] ?? ""}
                alt={equipo.nombre}
                width="600"
                height="450"
                draggable="false"
                class="h-full w-full object-contain object-center transition-transform duration-500 group-hover:scale-105 drop-shadow-sm pointer-events-none select-none"
                loading="lazy"
                decoding="async"
              />

              {/* Badge Estático de Modalidad (Color plano sobrio) */}
              <span
                class={`absolute top-3 left-3 inline-flex items-center rounded border px-2.5 py-1 font-display text-[11px] font-bold tracking-wider uppercase shadow-xs pointer-events-none ${BADGE_MODALIDAD_CLASS}`}
              >
                {equipo.modalidad}
              </span>
            </button>

            {/* Cuerpo de la Tarjeta */}
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <h3 class="font-display text-2xl leading-tight font-bold tracking-tight text-neutral-950 uppercase">
                {equipo.nombre}
              </h3>

              {/* Callout de Ahorro en Diésel (compacto y legible en móvil sin cortes) */}
              {equipo.ahorro_destacado && (
                <div class="mt-3 flex items-center justify-between rounded border border-emerald-500/30 bg-emerald-500/10 px-3 py-2 text-emerald-950">
                  <div class="flex items-center gap-1.5 font-display text-xs sm:text-sm font-bold tracking-wide">
                    <Zap
                      class="size-3.5 text-emerald-600 shrink-0"
                      aria-hidden="true"
                    />
                    <span>Ahorro Diésel: {equipo.ahorro_destacado.monto}</span>
                  </div>
                  <span class="rounded bg-emerald-600/15 px-1.5 py-0.5 text-[10px] font-bold text-emerald-900 uppercase tracking-wide">
                    {equipo.ahorro_destacado.subtitulo}
                  </span>
                </div>
              )}

              {/* Viñetas Clave (Legibles en móvil, sin truncation ni cortes) */}
              <ul class="mt-3.5 space-y-2 border-t border-neutral-100 pt-3 text-xs sm:text-[13px] text-neutral-800">
                {equipo.bullets_clave.map((bullet) => (
                  <li class="flex items-start gap-2">
                    <Check
                      class="size-3.5 text-emerald-600 shrink-0 mt-0.5"
                      stroke-width={2.5}
                      aria-hidden="true"
                    />
                    <span class="leading-snug">{bullet}</span>
                  </li>
                ))}
              </ul>

              {/* Sellos de Cumplimiento Normativo (SEC / IP66 / IK10) */}
              {equipo.certificaciones_chips &&
                equipo.certificaciones_chips.length > 0 && (
                  <div class="mt-3.5 flex flex-wrap items-center gap-1.5">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400 mr-0.5">
                      {equipo.certificaciones_chips.some((c) =>
                        ["SEC", "IP66", "IP67", "IK10"].includes(c),
                      )
                        ? "Certificación:"
                        : "Características:"}
                    </span>
                    {equipo.certificaciones_chips.map((cert) => (
                      <span class="inline-flex items-center rounded border border-neutral-300/80 bg-neutral-100 px-1.5 py-0.5 font-mono text-[10.5px] font-bold text-neutral-800">
                        {cert}
                      </span>
                    ))}
                  </div>
                )}

              <div class="mt-4 flex-1" />

              {/* ACCIONES: Botón de WhatsApp dominante + enlace secundario limpio */}
              <div class="flex flex-col gap-2 pt-3 border-t border-neutral-100">
                <a
                  href={whatsappLink(equipo.mensaje_whatsapp)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex h-11 sm:h-12 w-full items-center justify-center gap-2 rounded-md border border-[#20ba5a] bg-[#25D366] px-4 font-display text-sm font-bold tracking-wider text-neutral-950 uppercase shadow-xs transition-all duration-200 hover:bg-[#20ba5a] hover:shadow-sm active:scale-[0.99] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    class="size-4.5 shrink-0 transition-transform group-hover:scale-110 text-neutral-950"
                  >
                    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38c1.45.79 3.08 1.2 4.79 1.2h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01c-1.5 0-2.97-.4-4.26-1.17l-.3-.18-3.12.82.83-3.04-.2-.31a8.24 8.24 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.41a8.16 8.16 0 0 1 2.41 5.83c0 4.54-3.7 8.25-8.16 8.25Zm4.53-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.06-.39-2.02-1.25-.75-.66-1.25-1.48-1.39-1.73-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.42.06-.64.31-.22.25-.85.83-.85 2.02 0 1.19.87 2.34.99 2.5.12.17 1.7 2.6 4.12 3.64.58.25 1.02.4 1.37.51.58.19 1.1.16 1.52.1.46-.07 1.47-.6 1.68-1.19.21-.58.21-1.08.15-1.19-.06-.1-.23-.16-.48-.29Z" />
                  </svg>
                  <span>Cotizar por WhatsApp</span>
                </a>

                {/* Enlace Secundario: Abre Modal sin competir visualmente */}
                <button
                  type="button"
                  data-open-modal={equipo.id}
                  data-producto-id={equipo.id}
                  class="group inline-flex items-center justify-center gap-1.5 py-1 text-xs font-semibold tracking-wide text-neutral-600 hover:text-black transition-colors cursor-pointer focus:outline-none focus-visible:underline"
                >
                  <Eye
                    class="size-3.5 text-neutral-400 group-hover:text-black transition-colors"
                    aria-hidden="true"
                  />
                  <span>Ver galería de fotos y ficha completa &rarr;</span>
                </button>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    {/* Componente Modal de Detalle de Producto */}
    <ModalDetalleProducto maquinaria={catalogo} telefono={WHATSAPP_NUMBER} />
  </div>
</section>
