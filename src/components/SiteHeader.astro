---
import { whatsappLink } from "@/lib/site";
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 pointer-events-none flex justify-center transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] px-4"
>
  <nav
    id="header-nav"
    class="mt-2 md:mt-4 pointer-events-auto flex items-center justify-between rounded-full transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] max-w-[1180px] w-full bg-[#151515]/70 backdrop-blur-md backdrop-saturate-150 py-4 px-6 md:px-8 border border-white/10 shadow-sm"
  >
    <a
      href="#inicio"
      id="brand-logo"
      class="shrink-0 flex items-center gap-2.5 group transition-transform duration-300 hover:scale-[1.02]"
    >
      <img
        src="/images/ryba-logo-circular.webp"
        alt="Logo de RYBA SpA"
        width="36"
        height="36"
        class="size-8 md:size-9 rounded-full ring-1.5 ring-primary/60 object-cover shadow-sm transition-transform duration-300 group-hover:rotate-6"
      />
      <div
        class="flex items-baseline text-xl md:text-2xl tracking-tight font-bold font-sans select-none"
      >
        <span class="text-white font-extrabold tracking-tight">RYBA</span>
      </div>
    </a>

    <div
      class="hidden md:flex items-center gap-7 text-[14px] font-medium text-neutral-300 shrink-0"
    >
      <a
        href="#catalogo"
        class="nav-link hover:text-primary whitespace-nowrap transition-colors duration-200 py-1"
      >
        Catálogo
      </a>
      <a
        href="#servicios"
        class="nav-link hover:text-primary whitespace-nowrap transition-colors duration-200 py-1"
      >
        Servicios
      </a>
      <a
        href="#nosotros"
        class="nav-link hover:text-primary whitespace-nowrap transition-colors duration-200 py-1"
      >
        Nosotros
      </a>
    </div>

    <div class="hidden md:flex items-center gap-4 text-[14px] shrink-0">
      <a
        href={whatsappLink(
          "Hola Rodrigo, deseo solicitar una cotización de equipos para faena.",
        )}
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold text-neutral-950 bg-primary px-5 py-2.5 rounded-full whitespace-nowrap hover:bg-[#e09800] hover:-translate-y-[2px] shadow-sm hover:shadow-md transition-all duration-300 inline-flex items-center gap-2 text-[13.5px]"
      >
        <span>Cotizar</span>
        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          class="size-3.5 shrink-0 opacity-90"
        >
          <path
            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38c1.45.79 3.08 1.2 4.79 1.2h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01c-1.5 0-2.97-.4-4.26-1.17l-.3-.18-3.12.82.83-3.04-.2-.31a8.24 8.24 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.41a8.16 8.16 0 0 1 2.41 5.83c0 4.54-3.7 8.25-8.16 8.25Zm4.53-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.06-.39-2.02-1.25-.75-.66-1.25-1.48-1.39-1.73-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.42.06-.64.31-.22.25-.85.83-.85 2.02 0 1.19.87 2.34.99 2.5.12.17 1.7 2.6 4.12 3.64.58.25 1.02.4 1.37.51.58.19 1.1.16 1.52.1.46-.07 1.47-.6 1.68-1.19.21-.58.21-1.08.15-1.19-.06-.1-.23-.16-.48-.29Z"
          ></path>
        </svg>
      </a>
    </div>

    <!-- Botón Hamburguesa Mobile (Touch Target mínimo 44x44px) -->
    <button
      id="mobile-menu-btn"
      class="text-white focus:outline-none min-w-[44px] min-h-[44px] size-11 inline-flex items-center justify-center shrink-0 rounded-full hover:bg-white/10 transition-colors md:hidden focus-visible:ring-2 focus-visible:ring-primary"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg
        id="icon-menu"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-6 transition-transform duration-300 block"
      >
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
      <svg
        id="icon-close"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-6 transition-transform duration-300 hidden"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  </nav>

  <!-- Mobile Dropdown Menu Card (Fleect Style Floating Menu) -->
  <div
    id="mobile-menu"
    class="pointer-events-none absolute left-4 right-4 bg-[#151515]/95 backdrop-blur-2xl border border-white/15 rounded-2xl overflow-hidden shadow-2xl md:hidden opacity-0 scale-95 -translate-y-3 transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] invisible"
    style="top: calc(env(safe-area-inset-top, 0px) + 72px);"
  >
    <nav class="flex flex-col px-6 py-5 text-[15.5px] font-semibold text-left">
      <a
        href="#catalogo"
        class="mobile-nav-link text-left text-neutral-200 hover:text-primary py-3.5 border-b border-white/10 transition-colors"
      >
        Catálogo de Equipos
      </a>
      <a
        href="#servicios"
        class="mobile-nav-link text-left text-neutral-200 hover:text-primary py-3.5 border-b border-white/10 transition-colors"
      >
        Servicios
      </a>
      <a
        href="#nosotros"
        class="mobile-nav-link text-left text-neutral-200 hover:text-primary py-3.5 transition-colors"
      >
        Nosotros
      </a>

      <!-- Botón Cotizar dentro del menú hamburguesa -->
      <div class="mt-3 pt-3.5 border-t border-white/10">
        <a
          id="mobile-menu-cotizar-btn"
          href={whatsappLink(
            "Hola Rodrigo, deseo solicitar una cotización de equipos para faena.",
          )}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full py-3 px-5 rounded-full bg-primary hover:bg-[#e09800] text-neutral-950 font-bold text-[14px] shadow-sm active:scale-[0.98] transition-all"
        >
          <span>Cotizar</span>
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            class="size-3.5 shrink-0 opacity-90"
          >
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38c1.45.79 3.08 1.2 4.79 1.2h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01c-1.5 0-2.97-.4-4.26-1.17l-.3-.18-3.12.82.83-3.04-.2-.31a8.24 8.24 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.41a8.16 8.16 0 0 1 2.41 5.83c0 4.54-3.7 8.25-8.16 8.25Zm4.53-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.06-.39-2.02-1.25-.75-.66-1.25-1.48-1.39-1.73-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.42.06-.64.31-.22.25-.85.83-.85 2.02 0 1.19.87 2.34.99 2.5.12.17 1.7 2.6 4.12 3.64.58.25 1.02.4 1.37.51.58.19 1.1.16 1.52.1.46-.07 1.47-.6 1.68-1.19.21-.58.21-1.08.15-1.19-.06-.1-.23-.16-.48-.29Z"
            ></path>
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function setupHeader() {
    const nav = document.getElementById("header-nav");
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconMenu = document.getElementById("icon-menu");
    const iconClose = document.getElementById("icon-close");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");
    const brandLogo = document.getElementById("brand-logo");

    if (!nav || !menuBtn || !mobileMenu) return;

    let isMenuOpen = false;

    // Control del efecto flotante y encogimiento al hacer scroll (Comportamiento Fleect)
    function handleScroll() {
      const isScrolled = window.scrollY > 20 || isMenuOpen;

      if (isScrolled) {
        nav?.classList.remove(
          "max-w-[1180px]",
          "py-4",
          "px-6",
          "md:px-8",
          "bg-[#151515]/70",
          "backdrop-blur-md",
          "border-white/10",
          "shadow-sm",
        );
        nav?.classList.add(
          "max-w-[1000px]",
          "py-2.5",
          "px-5",
          "md:px-6",
          "bg-[#151515]/85",
          "backdrop-blur-xl",
          "border-white/20",
          "shadow-[0_12px_36px_rgba(0,0,0,0.45)]",
        );
      } else {
        nav?.classList.remove(
          "max-w-[1000px]",
          "py-2.5",
          "px-5",
          "md:px-6",
          "bg-[#151515]/85",
          "backdrop-blur-xl",
          "border-white/20",
          "shadow-[0_12px_36px_rgba(0,0,0,0.45)]",
        );
        nav?.classList.add(
          "max-w-[1180px]",
          "py-4",
          "px-6",
          "md:px-8",
          "bg-[#151515]/70",
          "backdrop-blur-md",
          "border-white/10",
          "shadow-sm",
        );
      }
    }

    function toggleMenu(forceClose = false) {
      if (forceClose) {
        isMenuOpen = false;
      } else {
        isMenuOpen = !isMenuOpen;
      }

      menuBtn?.setAttribute("aria-expanded", String(isMenuOpen));

      if (isMenuOpen) {
        // Abrir menú con animación
        mobileMenu?.classList.remove(
          "opacity-0",
          "scale-95",
          "-translate-y-3",
          "invisible",
          "pointer-events-none",
        );
        mobileMenu?.classList.add(
          "opacity-100",
          "scale-100",
          "translate-y-0",
          "visible",
          "pointer-events-auto",
        );
        iconMenu?.classList.add("hidden");
        iconClose?.classList.remove("hidden");
        document.body.style.overflow = "hidden";
        window.__lenis?.stop();
      } else {
        // Cerrar menú
        mobileMenu?.classList.remove(
          "opacity-100",
          "scale-100",
          "translate-y-0",
          "visible",
          "pointer-events-auto",
        );
        mobileMenu?.classList.add(
          "opacity-0",
          "scale-95",
          "-translate-y-3",
          "invisible",
          "pointer-events-none",
        );
        iconMenu?.classList.remove("hidden");
        iconClose?.classList.add("hidden");
        document.body.style.overflow = "unset";
        window.__lenis?.start();
      }

      handleScroll();
    }

    // Event listeners
    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();

    menuBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    brandLogo?.addEventListener("click", () => {
      toggleMenu(true);
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        toggleMenu(true);
      });
    });

    const mobileCotizarBtn = document.getElementById("mobile-menu-cotizar-btn");
    mobileCotizarBtn?.addEventListener("click", () => {
      toggleMenu(true);
    });

    // Cerrar al presionar Escape o clic fuera
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isMenuOpen) {
        toggleMenu(true);
      }
    });

    document.addEventListener("click", (e) => {
      if (
        isMenuOpen &&
        !mobileMenu.contains(e.target as Node) &&
        !menuBtn.contains(e.target as Node)
      ) {
        toggleMenu(true);
      }
    });
  }

  // Inicializar en carga y tras navegaciones de Astro
  setupHeader();
  document.addEventListener("astro:page-load", setupHeader);
</script>
