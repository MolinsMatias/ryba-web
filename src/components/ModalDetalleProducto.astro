---
export interface Especificacion {
  label: string;
  valor: string;
  icono?: "capacidad" | "potencia" | "peso" | "ano" | string;
}

export interface Disponibilidad {
  estado: string;
  detalle: string;
}

export interface VarianteModal {
  id: string;
  nombre_tab: string;
  subtitulo?: string;
  mensaje_whatsapp?: string;
  imagenes?: string[];
  especificaciones?: Especificacion[];
}

export interface ProductoModal {
  id: string;
  nombre: string;
  descripcion_corta: string;
  modalidad?: string;
  mensaje_whatsapp?: string;
  imagenes?: string[];
  especificaciones?: Especificacion[];
  disponibilidad?: Disponibilidad;
  variantes?: VarianteModal[];
}

interface Props {
  maquinaria: ProductoModal[];
  telefono: string;
}

const { maquinaria, telefono } = Astro.props;
---

<dialog
  id="modal-detalle-producto"
  aria-labelledby="modal-producto-nombre"
  aria-modal="true"
  class="fixed inset-0 z-50 m-auto w-full max-w-5xl bg-transparent p-3 sm:p-4 md:p-6 border-0 overflow-visible backdrop:backdrop-blur-[2px]"
>
  <div
    data-purpose="modal-card"
    data-lenis-prevent
    tabindex="-1"
    class="relative flex w-full flex-col md:flex-row gap-6 md:gap-8 rounded-2xl bg-white p-6 md:p-8 shadow-2xl border border-black/5 max-h-[92vh] md:max-h-none overflow-y-auto md:overflow-visible transition-all animate-fade-in focus:outline-none"
  >
    <button
      id="modal-btn-cerrar-x"
      type="button"
      aria-label="Cerrar ventana modal"
      class="absolute top-4 right-4 md:top-5 md:right-5 z-20 flex min-w-[44px] min-h-[44px] size-11 items-center justify-center rounded-full bg-white/95 text-neutral-700 hover:text-black hover:bg-white shadow-md backdrop-blur-sm border border-neutral-200/60 transition-all hover:scale-105 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer"
    >
      <svg
        class="size-4 md:size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div
      class="flex w-full md:w-[54%] flex-col items-center justify-center shrink-0"
    >
      <div
        id="modal-carrusel-contenedor"
        class="group relative flex items-center justify-center w-full aspect-4/3 overflow-hidden rounded-xl bg-neutral-100/90 shadow-inner select-none p-2 sm:p-4"
      >
        <div
          id="modal-carrusel-img-trigger"
          class="relative h-full w-full flex items-center justify-center outline-none select-none [-webkit-tap-highlight-color:transparent]"
        >
          <img
            id="modal-imagen-principal"
            src=""
            alt="Imagen del equipo"
            class="h-full w-full object-contain object-center drop-shadow-sm transition-opacity duration-300 pointer-events-none"
          />
        </div>

        <button
          id="modal-btn-expandir-fullscreen"
          type="button"
          aria-label="Ver imagen a pantalla completa"
          class="absolute bottom-3 left-1/2 -translate-x-1/2 sm:bottom-auto sm:top-3 sm:right-3 sm:left-auto sm:translate-x-0 z-10 flex items-center gap-1.5 rounded-lg bg-neutral-900/85 hover:bg-neutral-950 text-white px-3 py-1.5 sm:px-2.5 sm:py-1 text-xs font-semibold backdrop-blur-md transition-all shadow-md cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366] active:scale-95 whitespace-nowrap"
        >
          <svg
            class="size-3.5 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"
            ></path>
          </svg>
          <span class="text-[11px] font-bold uppercase tracking-wider"
            >Ampliar</span
          >
        </button>

        <div
          id="modal-imagen-placeholder"
          class="absolute inset-0 flex flex-col items-center justify-center bg-muted gap-2 text-muted-foreground"
        >
          <svg
            class="size-12 opacity-60"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
            ></path>
          </svg>
          <span class="text-xs font-semibold uppercase tracking-wider"
            >Foto del equipo</span
          >
        </div>

        <button
          id="modal-carrusel-btn-prev"
          type="button"
          aria-label="Imagen anterior"
          class="absolute left-2 sm:left-3 top-1/2 -translate-y-1/2 z-10 flex min-w-[44px] min-h-[44px] size-11 items-center justify-center rounded-full bg-neutral-900/70 text-white backdrop-blur-sm transition-all hover:bg-neutral-900/90 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer"
        >
          <svg
            class="size-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>

        <button
          id="modal-carrusel-btn-next"
          type="button"
          aria-label="Siguiente imagen"
          class="absolute right-2 sm:right-3 top-1/2 -translate-y-1/2 z-10 flex min-w-[44px] min-h-[44px] size-11 items-center justify-center rounded-full bg-neutral-900/70 text-white backdrop-blur-sm transition-all hover:bg-neutral-900/90 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer"
        >
          <svg
            class="size-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>

      <div
        id="modal-carrusel-dots"
        class="mt-3.5 flex items-center justify-center gap-1.5"
        role="tablist"
        aria-label="Diapositivas de la galería"
      >
      </div>
    </div>

    <div class="flex w-full md:w-[46%] flex-col justify-between pt-1">
      <div>
        <span
          id="modal-producto-modalidad"
          class="hidden mb-2 items-center rounded border border-neutral-800 bg-neutral-900 px-2.5 py-0.5 font-display text-[11px] font-bold uppercase tracking-wider text-white"
        >
        </span>

        <h2
          id="modal-producto-nombre"
          class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 uppercase"
        >
        </h2>
        <p
          id="modal-producto-descripcion"
          class="mt-1.5 text-xs sm:text-sm leading-relaxed text-neutral-500"
        >
        </p>

        <div
          id="modal-tabs-variantes-bloque"
          class="hidden mt-4 pt-3.5 border-t border-neutral-100"
        >
          <span
            class="block text-[11px] font-bold uppercase tracking-wider text-neutral-500 mb-2"
          >
            Seleccionar Tonelaje / Capacidad:
          </span>
          <div
            id="modal-tabs-variantes-lista"
            class="flex items-center gap-1.5 p-1 rounded-lg bg-neutral-100 border border-neutral-200/90"
            role="tablist"
            aria-label="Capacidades de tonelaje disponibles"
          >
          </div>
        </div>

        <div class="mt-4 sm:mt-5 border-t border-neutral-100 pt-3.5">
          <h3
            class="text-xs font-bold uppercase tracking-wider text-neutral-900 mb-3"
          >
            Especificaciones Técnicas
          </h3>
          <div
            id="modal-especificaciones-lista"
            class="space-y-2.5 text-xs sm:text-[13px]"
          >
          </div>
        </div>
      </div>

      <div class="mt-6 flex flex-col gap-2.5">
        <a
          id="modal-btn-whatsapp"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex w-full items-center justify-center gap-2 rounded-lg border border-[#20ba5a] bg-[#25D366] hover:bg-[#20ba5a] px-4 py-3 text-xs font-bold uppercase tracking-wider text-neutral-950 shadow-sm transition-all active:scale-[0.99]"
        >
          <svg
            class="size-4 shrink-0 fill-current text-neutral-950 transition-transform group-hover:scale-110"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38c1.45.79 3.08 1.2 4.79 1.2h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01c-1.5 0-2.97-.4-4.26-1.17l-.3-.18-3.12.82.83-3.04-.2-.31a8.24 8.24 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.41a8.16 8.16 0 0 1 2.41 5.83c0 4.54-3.7 8.25-8.16 8.25Zm4.53-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.06-.39-2.02-1.25-.75-.66-1.25-1.48-1.39-1.73-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.42.06-.64.31-.22.25-.85.83-.85 2.02 0 1.19.87 2.34.99 2.5.12.17 1.7 2.6 4.12 3.64.58.25 1.02.4 1.37.51.58.19 1.1.16 1.52.1.46-.07 1.47-.6 1.68-1.19.21-.58.21-1.08.15-1.19-.06-.1-.23-.16-.48-.29Z"
            ></path>
          </svg>
          <span>Cotizar por WhatsApp</span>
        </a>

        <button
          id="modal-btn-cerrar-secundario"
          type="button"
          class="flex min-h-[44px] w-full items-center justify-center rounded-lg border border-neutral-900 bg-white hover:bg-neutral-50 px-4 py-3 text-xs font-bold uppercase tracking-wider text-neutral-900 transition-all active:scale-[0.99] cursor-pointer"
        >
          Cerrar
        </button>
      </div>
    </div>
  </div>
</dialog>

<dialog
  id="modal-lightbox-dialog"
  data-lenis-prevent
  aria-label="Visor de imagen a pantalla completa"
  class="fixed inset-0 m-0 h-screen w-screen max-h-none max-w-none bg-black/95 text-white p-0 border-0 overflow-hidden backdrop:bg-black/95 z-[100]"
>
  <div class="relative flex flex-col h-full w-full justify-between p-4 sm:p-6">
    <div class="flex items-center justify-between gap-4 z-20 shrink-0">
      <div class="flex flex-col">
        <span
          id="lightbox-producto-nombre"
          class="font-display text-sm sm:text-base font-bold tracking-wider uppercase text-neutral-200"
        >
        </span>
        <span
          id="lightbox-contador"
          class="text-xs font-medium text-neutral-400"
        >
          Foto 1 de 1
        </span>
      </div>

      <button
        id="lightbox-btn-cerrar"
        type="button"
        aria-label="Cerrar visor de pantalla completa"
        class="flex size-11 items-center justify-center rounded-full bg-white/10 hover:bg-white/20 active:bg-white/30 text-white transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366]"
      >
        <svg
          class="size-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div
      id="lightbox-carrusel-contenedor"
      class="relative flex-1 flex items-center justify-center w-full min-h-0 py-2 select-none overflow-hidden"
    >
      <img
        id="lightbox-imagen-principal"
        src=""
        alt="Foto ampliada del equipo"
        class="max-h-full max-w-full object-contain drop-shadow-2xl transition-opacity duration-200 pointer-events-none"
      />

      <button
        id="lightbox-btn-prev"
        type="button"
        aria-label="Foto anterior"
        class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-10 flex size-12 items-center justify-center rounded-full bg-black/60 hover:bg-black/90 active:scale-95 text-white border border-white/10 backdrop-blur-md transition-all cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366]"
      >
        <svg
          class="size-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <button
        id="lightbox-btn-next"
        type="button"
        aria-label="Siguiente foto"
        class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-10 flex size-12 items-center justify-center rounded-full bg-black/60 hover:bg-black/90 active:scale-95 text-white border border-white/10 backdrop-blur-md transition-all cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366]"
      >
        <svg
          class="size-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </button>
    </div>

    <div
      class="flex flex-col items-center justify-center gap-2.5 pt-2 z-20 shrink-0 w-full"
    >
      <div id="lightbox-dots" class="flex items-center justify-center gap-2">
      </div>

      <a
        id="lightbox-btn-whatsapp"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-11 items-center justify-center gap-2 rounded-lg bg-[#25D366] hover:bg-[#20ba5a] active:scale-[0.99] px-6 text-xs font-bold uppercase tracking-wider text-neutral-950 shadow-md transition-all cursor-pointer"
      >
        <svg
          class="size-4 shrink-0 fill-current text-neutral-950"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38c1.45.79 3.08 1.2 4.79 1.2h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01c-1.5 0-2.97-.4-4.26-1.17l-.3-.18-3.12.82.83-3.04-.2-.31a8.24 8.24 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.41a8.16 8.16 0 0 1 2.41 5.83c0 4.54-3.7 8.25-8.16 8.25Zm4.53-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.06-.39-2.02-1.25-.75-.66-1.25-1.48-1.39-1.73-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.42.06-.64.31-.22.25-.85.83-.85 2.02 0 1.19.87 2.34.99 2.5.12.17 1.7 2.6 4.12 3.64.58.25 1.02.4 1.37.51.58.19 1.1.16 1.52.1.46-.07 1.47-.6 1.68-1.19.21-.58.21-1.08.15-1.19-.06-.1-.23-.16-.48-.29Z"
          ></path>
        </svg>
        <span>Cotizar este equipo por WhatsApp</span>
      </a>
    </div>
  </div>
</dialog>

<script
  id="datos-catalogo-modal"
  type="application/json"
  set:html={JSON.stringify(maquinaria)}
/>
<script
  id="telefono-whatsapp-modal"
  type="application/json"
  set:html={JSON.stringify(telefono)}
/>

<script>
  function inicializarModalDetalle() {
    const dialogElement = document.getElementById("modal-detalle-producto");
    const datosScript = document.getElementById("datos-catalogo-modal");
    const telScript = document.getElementById("telefono-whatsapp-modal");

    if (!dialogElement || !datosScript || !telScript) return;
    const dialog = dialogElement as HTMLDialogElement;

    interface VarianteItem {
      id: string;
      nombre_tab: string;
      subtitulo?: string;
      mensaje_whatsapp?: string;
      imagenes?: string[];
      especificaciones?: EspecificacionItem[];
    }

    interface EspecificacionItem {
      label: string;
      valor: string;
      icono?: string;
    }

    interface ProductoItem {
      id: string;
      nombre: string;
      descripcion_corta: string;
      modalidad?: string;
      mensaje_whatsapp?: string;
      imagenes?: string[];
      especificaciones?: EspecificacionItem[];
      disponibilidad?: {
        estado?: string;
        detalle?: string;
      };
      variantes?: VarianteItem[];
    }

    let productos: ProductoItem[] = [];
    let telefono = "";
    try {
      productos = JSON.parse(datosScript.textContent || "[]");
      telefono = JSON.parse(telScript.textContent || '""');
    } catch (e) {
      console.error("Error al parsear datos para el modal", e);
      return;
    }

    // Elementos del Modal
    const modalidadEl = document.getElementById("modal-producto-modalidad");
    const nombreEl = document.getElementById("modal-producto-nombre");
    const descEl = document.getElementById("modal-producto-descripcion");
    const specsEl = document.getElementById("modal-especificaciones-lista");
    const tabsBloque = document.getElementById("modal-tabs-variantes-bloque");
    const tabsLista = document.getElementById("modal-tabs-variantes-lista");
    const btnWhatsapp = document.getElementById(
      "modal-btn-whatsapp",
    ) as HTMLAnchorElement | null;
    const btnCerrarX = document.getElementById("modal-btn-cerrar-x");
    const btnCerrarSec = document.getElementById("modal-btn-cerrar-secundario");

    // Elementos del Carrusel Modal
    const carruselContenedor = document.getElementById(
      "modal-carrusel-contenedor",
    );
    const imgEl = document.getElementById(
      "modal-imagen-principal",
    ) as HTMLImageElement | null;
    const imgPlaceholder = document.getElementById("modal-imagen-placeholder");
    const btnPrev = document.getElementById("modal-carrusel-btn-prev");
    const btnNext = document.getElementById("modal-carrusel-btn-next");
    const dotsContainer = document.getElementById("modal-carrusel-dots");
    const btnExpandir = document.getElementById(
      "modal-btn-expandir-fullscreen",
    );

    // Elementos del Lightbox Fullscreen
    const lightboxDialog = document.getElementById(
      "modal-lightbox-dialog",
    ) as HTMLDialogElement | null;
    const lightboxImg = document.getElementById(
      "lightbox-imagen-principal",
    ) as HTMLImageElement | null;
    const lightboxContador = document.getElementById("lightbox-contador");
    const lightboxNombre = document.getElementById("lightbox-producto-nombre");
    const lightboxBtnWhatsapp = document.getElementById(
      "lightbox-btn-whatsapp",
    ) as HTMLAnchorElement | null;
    const lightboxBtnCerrar = document.getElementById("lightbox-btn-cerrar");
    const lightboxBtnPrev = document.getElementById("lightbox-btn-prev");
    const lightboxBtnNext = document.getElementById("lightbox-btn-next");
    const lightboxDots = document.getElementById("lightbox-dots");
    const lightboxContenedor = document.getElementById(
      "lightbox-carrusel-contenedor",
    );

    let imagenesActuales: string[] = [];
    let indiceActual = 0;
    let productoActual: ProductoItem | null = null;

    // Iconos SVG para especificaciones técnicas
    function obtenerIconoSpec(tipo?: string) {
      switch (tipo) {
        case "capacidad":
          return `<svg class="size-4 text-neutral-500 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>`;
        case "potencia":
          return `<svg class="size-4 text-neutral-500 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>`;
        case "peso":
          return `<svg class="size-4 text-neutral-500 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path></svg>`;
        case "ano":
          return `<svg class="size-4 text-neutral-500 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>`;
        case "autonomia":
          return `<svg class="size-4 text-neutral-500 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>`;
        case "ahorro":
          return `<svg class="size-4 text-neutral-500 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>`;
        case "certificacion":
          return `<svg class="size-4 text-neutral-500 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"></path></svg>`;
        case "montaje":
          return `<svg class="size-4 text-neutral-500 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.049.58.025 1.193-.14 1.743"></path></svg>`;
        default:
          return `<svg class="size-4 text-neutral-500 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>`;
      }
    }

    function actualizarSlide(indice: number) {
      if (!imgEl || !dotsContainer) return;
      if (imagenesActuales.length === 0) {
        imgEl.classList.add("hidden");
        if (imgPlaceholder) imgPlaceholder.classList.remove("hidden");
        if (btnPrev) btnPrev.classList.add("hidden");
        if (btnNext) btnNext.classList.add("hidden");
        if (btnExpandir) btnExpandir.classList.add("hidden");
        dotsContainer.innerHTML = "";
        return;
      }

      if (imgPlaceholder) imgPlaceholder.classList.add("hidden");
      imgEl.classList.remove("hidden");
      if (btnExpandir) btnExpandir.classList.remove("hidden");

      // Circular index
      indiceActual =
        (indice + imagenesActuales.length) % imagenesActuales.length;
      imgEl.src = imagenesActuales[indiceActual];

      // Ocultar controles si solo hay 1 imagen
      const tieneMultiples = imagenesActuales.length > 1;
      if (btnPrev) btnPrev.style.display = tieneMultiples ? "flex" : "none";
      if (btnNext) btnNext.style.display = tieneMultiples ? "flex" : "none";

      // Actualizar dots en carrusel del modal
      dotsContainer.innerHTML = "";
      if (tieneMultiples) {
        imagenesActuales.forEach((_, i) => {
          const dot = document.createElement("button");
          dot.type = "button";
          dot.setAttribute("aria-label", `Slide ${i + 1}`);
          dot.className =
            i === indiceActual
              ? "size-2 rounded-full bg-neutral-900 transition-all cursor-pointer"
              : "size-1.5 rounded-full bg-neutral-300 hover:bg-neutral-400 transition-all cursor-pointer";
          dot.addEventListener("click", () => actualizarSlide(i));
          dotsContainer.appendChild(dot);
        });
      }

      // Sincronizar Lightbox si está abierto
      if (lightboxDialog && lightboxDialog.open) {
        sincronizarLightbox();
      }
    }

    function sincronizarLightbox() {
      if (!lightboxImg || imagenesActuales.length === 0) return;
      const tieneMultiples = imagenesActuales.length > 1;
      lightboxImg.src = imagenesActuales[indiceActual];
      if (lightboxContador) {
        lightboxContador.textContent = `Foto ${indiceActual + 1} de ${imagenesActuales.length}`;
      }
      if (lightboxBtnPrev)
        lightboxBtnPrev.style.display = tieneMultiples ? "flex" : "none";
      if (lightboxBtnNext)
        lightboxBtnNext.style.display = tieneMultiples ? "flex" : "none";

      if (lightboxDots) {
        lightboxDots.innerHTML = "";
        if (tieneMultiples) {
          imagenesActuales.forEach((_, i) => {
            const dot = document.createElement("button");
            dot.type = "button";
            dot.setAttribute("aria-label", `Foto ${i + 1}`);
            dot.className =
              i === indiceActual
                ? "size-2.5 rounded-full bg-white transition-all cursor-pointer"
                : "size-2 rounded-full bg-white/40 hover:bg-white/70 transition-all cursor-pointer";
            dot.addEventListener("click", () => actualizarSlide(i));
            lightboxDots.appendChild(dot);
          });
        }
      }
    }

    function abrirModal(id: string) {
      const producto = productos.find((p) => p.id === id);
      if (!producto) return;
      productoActual = producto;

      // Modalidad comercial
      if (modalidadEl) {
        if (producto.modalidad) {
          modalidadEl.textContent = producto.modalidad;
          modalidadEl.classList.remove("hidden");
        } else {
          modalidadEl.classList.add("hidden");
        }
      }

      if (nombreEl) nombreEl.textContent = producto.nombre;
      if (descEl) descEl.textContent = producto.descripcion_corta;

      // Renderizador reutilizable de especificaciones técnicas
      function renderizarEspecificaciones(specs: EspecificacionItem[]) {
        if (!specsEl) return;
        specsEl.innerHTML = "";
        if (specs.length === 0) {
          specsEl.innerHTML = `<p class="text-neutral-400 italic text-xs">Especificaciones disponibles a solicitud del cliente.</p>`;
        } else {
          specs.forEach((spec: EspecificacionItem) => {
            const row = document.createElement("div");
            row.className =
              "flex items-center justify-between text-neutral-700";
            row.innerHTML = `
              <div class="flex items-center gap-2.5">
                ${obtenerIconoSpec(spec.icono)}
                <span>${spec.label}</span>
              </div>
              <span class="font-semibold text-neutral-900">${spec.valor}</span>
            `;
            specsEl.appendChild(row);
          });
        }
      }

      function seleccionarVariante(indice: number) {
        if (!producto) return;
        const itemProducto = producto;
        if (!itemProducto.variantes) return;
        const variante = itemProducto.variantes[indice];
        if (!variante) return;

        // 1. Estilos de pestañas activas e inactivas
        if (tabsLista) {
          const botones = tabsLista.querySelectorAll("button");
          botones.forEach((btn, i) => {
            if (i === indice) {
              btn.className =
                "flex-1 py-1.5 px-3 text-center rounded-md bg-neutral-900 text-white font-display text-xs font-bold uppercase tracking-wider shadow-xs cursor-pointer transition-all";
              btn.setAttribute("aria-selected", "true");
            } else {
              btn.className =
                "flex-1 py-1.5 px-3 text-center rounded-md text-neutral-600 hover:text-black hover:bg-white/80 font-display text-xs font-semibold uppercase tracking-wider cursor-pointer transition-all";
              btn.setAttribute("aria-selected", "false");
            }
          });
        }

        // 2. Galería de fotos correspondiente a la variante
        if (Array.isArray(variante.imagenes) && variante.imagenes.length > 0) {
          imagenesActuales = variante.imagenes;
        } else {
          imagenesActuales = Array.isArray(itemProducto.imagenes)
            ? itemProducto.imagenes
            : [];
        }
        actualizarSlide(0);

        // 3. Especificaciones técnicas de la variante
        const specs =
          Array.isArray(variante.especificaciones) &&
          variante.especificaciones.length > 0
            ? variante.especificaciones
            : Array.isArray(itemProducto.especificaciones)
              ? itemProducto.especificaciones
              : [];
        renderizarEspecificaciones(specs);

        // 4. Mensaje contextualizado de WhatsApp al tonelaje
        if (btnWhatsapp) {
          const mensaje =
            variante.mensaje_whatsapp ||
            itemProducto.mensaje_whatsapp ||
            `Hola Rodrigo, me interesa cotizar el ${itemProducto.nombre}`;
          btnWhatsapp.href = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;
        }
      }

      // Si el producto tiene variantes por capacidad (ej. Grúa Pluma de 500kg, 1T, 2T)
      if (tabsBloque && tabsLista) {
        if (
          Array.isArray(producto.variantes) &&
          producto.variantes.length > 0
        ) {
          tabsBloque.classList.remove("hidden");
          tabsLista.innerHTML = "";
          producto.variantes.forEach((variante, idx) => {
            const tabBtn = document.createElement("button");
            tabBtn.type = "button";
            tabBtn.setAttribute("role", "tab");
            tabBtn.textContent = variante.nombre_tab;
            tabBtn.addEventListener("click", () => {
              seleccionarVariante(idx);
            });
            tabsLista.appendChild(tabBtn);
          });
          seleccionarVariante(0);
        } else {
          tabsBloque.classList.add("hidden");
          tabsLista.innerHTML = "";

          // Galería estándar
          imagenesActuales =
            Array.isArray(producto.imagenes) && producto.imagenes.length > 0
              ? producto.imagenes
              : [];
          actualizarSlide(0);

          // Especificaciones estándar
          const specs = Array.isArray(producto.especificaciones)
            ? producto.especificaciones
            : [];
          renderizarEspecificaciones(specs);

          // WhatsApp estándar
          if (btnWhatsapp) {
            const mensaje =
              producto.mensaje_whatsapp ||
              `Hola Rodrigo, me interesa cotizar el ${producto.nombre}`;
            btnWhatsapp.href = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;
          }
        }
      } else {
        // Fallback sin variantes
        imagenesActuales =
          Array.isArray(producto.imagenes) && producto.imagenes.length > 0
            ? producto.imagenes
            : [];
        actualizarSlide(0);
        renderizarEspecificaciones(
          Array.isArray(producto.especificaciones)
            ? producto.especificaciones
            : [],
        );
        if (btnWhatsapp) {
          const mensaje =
            producto.mensaje_whatsapp ||
            `Hola Rodrigo, me interesa cotizar el ${producto.nombre}`;
          btnWhatsapp.href = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;
        }
      }

      // Bloquear scroll de fondo y abrir dialog nativo
      document.body.style.overflow = "hidden";
      window.__lenis?.stop();
      dialog.showModal();

      // Evitar que el navegador autoenfoque la X al abrir el modal
      const tarjeta = dialog.querySelector(
        '[data-purpose="modal-card"]',
      ) as HTMLElement | null;
      if (tarjeta) {
        tarjeta.focus({ preventScroll: true });
      } else if (btnCerrarX) {
        btnCerrarX.blur();
      }
    }

    let disparadorAnterior: HTMLElement | null = null;

    function cerrarModal() {
      document.body.style.overflow = "";
      window.__lenis?.start();
      dialog.close();
      if (disparadorAnterior) {
        if (disparadorAnterior.getAttribute("data-trigger-type") !== "photo") {
          disparadorAnterior.focus({ preventScroll: true });
        } else {
          disparadorAnterior.blur();
        }
        disparadorAnterior = null;
      }
    }

    // Funciones del Lightbox Fullscreen
    function abrirLightbox() {
      if (!lightboxDialog || imagenesActuales.length === 0) return;
      if (lightboxNombre && productoActual) {
        lightboxNombre.textContent = productoActual.nombre;
      }
      if (lightboxBtnWhatsapp && productoActual) {
        if (btnWhatsapp) {
          lightboxBtnWhatsapp.href = btnWhatsapp.href;
        } else {
          const mensaje =
            productoActual.mensaje_whatsapp ||
            `Hola Rodrigo, me interesa cotizar el ${productoActual.nombre}`;
          lightboxBtnWhatsapp.href = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;
        }
      }
      window.__lenis?.stop();
      lightboxDialog.showModal();
      sincronizarLightbox();
      // Enfocar el botón cerrar sin activar el anillo focus-visible en mobile
      if (lightboxBtnCerrar) {
        requestAnimationFrame(() => {
          lightboxBtnCerrar.focus({ preventScroll: true });
          // Quitar el anillo visual inmediatamente en dispositivos táctiles
          lightboxBtnCerrar.addEventListener(
            "blur",
            () => {
              /* el ring se oculta al perder foco */
            },
            { once: true },
          );
          // Si fue activado por touch, limpiar el focus-visible
          if (window.matchMedia("(pointer: coarse)").matches) {
            lightboxBtnCerrar.blur();
          }
        });
      }
    }

    function cerrarLightbox() {
      if (!lightboxDialog) return;
      lightboxDialog.close();
      if (!dialog.open) {
        window.__lenis?.start();
      }
    }

    // Listeners de cierre del modal principal
    if (btnCerrarX) btnCerrarX.addEventListener("click", cerrarModal);
    if (btnCerrarSec) btnCerrarSec.addEventListener("click", cerrarModal);

    // Cierre al hacer clic en el backdrop fuera de la tarjeta
    dialog.addEventListener("click", (event) => {
      const tarjeta = dialog.querySelector('[data-purpose="modal-card"]');
      if (tarjeta && !tarjeta.contains(event.target as Node)) {
        cerrarModal();
      }
    });

    // Restaurar scroll si se cierra con tecla ESC nativa
    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
      window.__lenis?.start();
      if (disparadorAnterior) {
        if (disparadorAnterior.getAttribute("data-trigger-type") !== "photo") {
          disparadorAnterior.focus({ preventScroll: true });
        } else {
          disparadorAnterior.blur();
        }
        disparadorAnterior = null;
      }
    });

    // Controles del Carrusel Modal: Botones Prev / Next
    if (btnPrev) {
      btnPrev.addEventListener("click", (e) => {
        e.stopPropagation();
        actualizarSlide(indiceActual - 1);
      });
    }

    if (btnNext) {
      btnNext.addEventListener("click", (e) => {
        e.stopPropagation();
        actualizarSlide(indiceActual + 1);
      });
    }

    // Disparadores del Lightbox
    if (btnExpandir) {
      btnExpandir.addEventListener("click", (e) => {
        e.stopPropagation();
        btnExpandir.blur();
        abrirLightbox();
      });
    }

    // El lightbox solo se abre desde el botón "Ampliar" (btnExpandir)
    // No se abre al hacer clic en la imagen directamente

    // Controles del Lightbox
    if (lightboxBtnCerrar) {
      lightboxBtnCerrar.addEventListener("click", (e) => {
        e.stopPropagation();
        cerrarLightbox();
      });
    }

    if (lightboxBtnPrev) {
      lightboxBtnPrev.addEventListener("click", (e) => {
        e.stopPropagation();
        actualizarSlide(indiceActual - 1);
      });
    }

    if (lightboxBtnNext) {
      lightboxBtnNext.addEventListener("click", (e) => {
        e.stopPropagation();
        actualizarSlide(indiceActual + 1);
      });
    }

    if (lightboxDialog) {
      lightboxDialog.addEventListener("click", (event) => {
        if (event.target === lightboxDialog) {
          cerrarLightbox();
        }
      });
    }

    // Navegación por teclado global (para Lightbox)
    window.addEventListener("keydown", (e) => {
      if (lightboxDialog && lightboxDialog.open) {
        if (e.key === "Escape") {
          e.preventDefault();
          e.stopPropagation();
          cerrarLightbox();
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          actualizarSlide(indiceActual - 1);
        } else if (e.key === "ArrowRight") {
          e.preventDefault();
          actualizarSlide(indiceActual + 1);
        }
      }
    });

    // Soporte Touch Swipe en carrusel del modal
    if (carruselContenedor) {
      let touchStartX = 0;
      let touchEndX = 0;
      let touchStartY = 0;
      let touchEndY = 0;

      carruselContenedor.addEventListener(
        "touchstart",
        (e) => {
          touchStartX = e.changedTouches[0].screenX;
          touchStartY = e.changedTouches[0].screenY;
        },
        { passive: true },
      );

      carruselContenedor.addEventListener(
        "touchend",
        (e) => {
          touchEndX = e.changedTouches[0].screenX;
          touchEndY = e.changedTouches[0].screenY;
          const deltaX = touchEndX - touchStartX;
          const deltaY = touchEndY - touchStartY;

          // Detectar swipe horizontal prioritario si no es un scroll vertical
          if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
            if (deltaX < 0) {
              actualizarSlide(indiceActual + 1); // Swipe izquierda -> siguiente
            } else {
              actualizarSlide(indiceActual - 1); // Swipe derecha -> anterior
            }
          }
        },
        { passive: true },
      );
    }

    // Soporte Touch Swipe en Lightbox fullscreen
    if (lightboxContenedor) {
      let lbTouchStartX = 0;
      let lbTouchEndX = 0;
      let lbTouchStartY = 0;
      let lbTouchEndY = 0;

      lightboxContenedor.addEventListener(
        "touchstart",
        (e) => {
          lbTouchStartX = e.changedTouches[0].screenX;
          lbTouchStartY = e.changedTouches[0].screenY;
        },
        { passive: true },
      );

      lightboxContenedor.addEventListener(
        "touchend",
        (e) => {
          lbTouchEndX = e.changedTouches[0].screenX;
          lbTouchEndY = e.changedTouches[0].screenY;
          const deltaX = lbTouchEndX - lbTouchStartX;
          const deltaY = lbTouchEndY - lbTouchStartY;

          if (Math.abs(deltaX) > 35 && Math.abs(deltaX) > Math.abs(deltaY)) {
            if (deltaX < 0) {
              actualizarSlide(indiceActual + 1);
            } else {
              actualizarSlide(indiceActual - 1);
            }
          }
        },
        { passive: true },
      );
    }

    // Vincular todos los botones de "Ver detalle" del catálogo
    document.querySelectorAll("[data-open-modal]").forEach((boton) => {
      boton.addEventListener("click", () => {
        disparadorAnterior = boton as HTMLElement;
        if (boton.getAttribute("data-trigger-type") === "photo") {
          (boton as HTMLElement).blur();
        }
        const id = boton.getAttribute("data-open-modal");
        if (id) abrirModal(id);
      });
    });
  }

  // Inicializar al cargar el DOM y en transiciones de navegación
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", inicializarModalDetalle);
  } else {
    inicializarModalDetalle();
  }
  document.addEventListener("astro:page-load", inicializarModalDetalle);
</script>
