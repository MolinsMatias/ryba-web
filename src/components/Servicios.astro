---
import Wrench from "lucide-astro/Wrench";
import Truck from "lucide-astro/Truck";
import HardHat from "lucide-astro/HardHat";
import { servicios, whatsappLink } from "@/lib/site";

const iconos = [Wrench, Truck, HardHat];
---

<section
  id="servicios"
  aria-labelledby="servicios-titulo"
  class="border-b border-border bg-card"
>
  <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-24">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <h2
        id="servicios-titulo"
        class="font-display text-4xl leading-none font-bold tracking-tight text-foreground uppercase sm:text-5xl"
      >
        Servicios
      </h2>
      <p class="max-w-md text-base leading-relaxed text-muted-foreground text-pretty">
        Soporte completo alrededor del equipo, para que la faena no se
        detenga.
      </p>
    </div>

    <ul class="mt-14 grid gap-px border border-border bg-border md:grid-cols-3">
      {servicios.map((servicio, i) => {
        const Icono = iconos[i];
        return (
          <li class="group relative flex flex-col justify-between bg-card p-8 transition-colors hover:bg-background">
            <div>
              <span
                aria-hidden="true"
                class="absolute inset-x-0 top-0 h-0.5 scale-x-0 bg-primary transition-transform duration-300 group-hover:scale-x-100"
              />
              <Icono
                class="size-6 text-primary"
                stroke-width={1.75}
                aria-hidden="true"
              />
              <h3 class="mt-6 font-display text-2xl font-semibold tracking-wide text-foreground uppercase">
                {servicio.titulo}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                {servicio.descripcion}
              </p>
            </div>
            <div class="mt-8 pt-4 border-t border-border/60">
              <a
                href={whatsappLink(servicio.mensajeWhatsapp)}
                target="_blank"
                rel="noopener noreferrer"
                class="group/btn inline-flex items-center gap-2 font-display text-xs font-bold uppercase tracking-wider text-primary hover:text-amber-400 transition-colors"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  class="size-3.5 shrink-0 text-[#25D366]"
                >
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38c1.45.79 3.08 1.2 4.79 1.2h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01c-1.5 0-2.97-.4-4.26-1.17l-.3-.18-3.12.82.83-3.04-.2-.31a8.24 8.24 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.41a8.16 8.16 0 0 1 2.41 5.83c0 4.54-3.7 8.25-8.16 8.25Zm4.53-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.06-.39-2.02-1.25-.75-.66-1.25-1.48-1.39-1.73-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.42.06-.64.31-.22.25-.85.83-.85 2.02 0 1.19.87 2.34.99 2.5.12.17 1.7 2.6 4.12 3.64.58.25 1.02.4 1.37.51.58.19 1.1.16 1.52.1.46-.07 1.47-.6 1.68-1.19.21-.58.21-1.08.15-1.19-.06-.1-.23-.16-.48-.29Z" />
                </svg>
                <span>Cotizar servicio</span>
                <span class="transition-transform group-hover/btn:translate-x-1" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>
