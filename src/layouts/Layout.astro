---
import "../styles/global.css";
import "lenis/dist/lenis.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "RYBA Equipos | Venta, Arriendo y Servicios de Equipos para Faena",
  description = "Equipos de respaldo energético, izaje e infraestructura con soporte técnico en terreno y logística a todo Chile para minería, construcción e industria.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-[#151515]">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="venta y arriendo de equipos, RYBA Equipos, generador electrico arriendo, grua pluma camioneta, torre de iluminacion solar, techo solar contenedor, fletes industriales, montaje industrial"
    />

    <!-- Status Bar & Theme Color para Safari iOS y Chrome Android -->
    <meta name="theme-color" content="#151515" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="RYBA Equipos | Venta, arriendo y servicios de equipos para faena"
    />
    <meta property="og:description" content={description} />

    <!-- Favicons -->
    <link
      rel="icon"
      href="/icon-light-32x32.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      href="/icon-dark-32x32.png"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />

    <!-- Google Fonts: Inter & Barlow Condensed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans antialiased bg-[#151515] text-foreground min-h-screen">
    <slot />

    <!-- Script de Smooth Scroll con Lenis -->
    <script>
      import Lenis from "lenis";

      declare global {
        interface Window {
          __lenis?: Lenis;
        }
      }

      function setupSmoothScroll() {
        if (window.__lenis) {
          window.__lenis.destroy();
        }

        const lenis = new Lenis({
          duration: 1.15,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          touchMultiplier: 1.2,
        });

        window.__lenis = lenis;

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // Suavizado premium al hacer clic en enlaces ancla (#inicio, #catalogo, etc.)
        const anchorLinks = document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]');
        anchorLinks.forEach((anchor) => {
          anchor.addEventListener("click", (e) => {
            const href = anchor.getAttribute("href");
            if (!href || href === "#") return;
            const target = document.querySelector<HTMLElement>(href);
            if (target) {
              e.preventDefault();
              lenis.scrollTo(target, {
                offset: 0,
                duration: 1.0,
                onComplete: () => {
                  target.setAttribute("tabindex", "-1");
                  target.focus({ preventScroll: true });
                },
              });
              if (history.pushState) {
                history.pushState(null, "", href);
              }
            }
          });
        });
      }

      setupSmoothScroll();
      document.addEventListener("astro:page-load", setupSmoothScroll);
    </script>
  </body>
</html>
