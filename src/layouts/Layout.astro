---
import "../styles/global.css";
import "lenis/dist/lenis.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "RYBA Equipos | Venta, Arriendo y Servicios de Equipos para Faena",
  description = "Equipos de respaldo energético, izaje e infraestructura con soporte técnico en terreno y logística a todo Chile para minería, construcción e industria.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-[#151515]">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="venta y arriendo de equipos Chile, RYBA Equipos, generador electrico arriendo Chile, grua pluma camioneta, grua oleo hidraulica, torre de iluminacion solar, techo solar contenedor, fletes industriales Chile, montaje industrial, equipos para mineria Chile, arriendo maquinaria pesada, infraestructura faena, respaldo energetico mineria, equipos construccion Chile"
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://ryba-web.m-molins03.workers.dev/" />

    <meta name="theme-color" content="#151515" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RYBA Equipos" />
    <meta property="og:url" content="https://ryba-web.m-molins03.workers.dev/" />
    <meta
      property="og:title"
      content="RYBA Equipos | Venta, Arriendo y Servicios de Equipos para Faena"
    />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://ryba-web.m-molins03.workers.dev/images/og-ryba-equipos.jpg"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="RYBA Equipos — Venta, Arriendo y Servicios de Equipos para Faena en Chile"
    />
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="RYBA Equipos | Venta, Arriendo y Servicios de Equipos para Faena"
    />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://ryba-web.m-molins03.workers.dev/images/og-ryba-equipos.jpg"
    />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon/favicon-16x16.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/favicon/favicon-96x96.png"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon/icon.svg" />

    <!-- Apple Touch Icons (iOS Safari) -->
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link
      rel="apple-touch-icon"
      sizes="57x57"
      href="/favicon/apple-icon-57x57.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="60x60"
      href="/favicon/apple-icon-60x60.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="72x72"
      href="/favicon/apple-icon-72x72.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="76x76"
      href="/favicon/apple-icon-76x76.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="114x114"
      href="/favicon/apple-icon-114x114.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="120x120"
      href="/favicon/apple-icon-120x120.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="144x144"
      href="/favicon/apple-icon-144x144.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="152x152"
      href="/favicon/apple-icon-152x152.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />

    <!-- Web App Manifest (PWA & Android) -->
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <!-- Microsoft Tiles & Windows -->
    <meta name="msapplication-TileColor" content="#151515" />
    <meta
      name="msapplication-TileImage"
      content="/favicon/ms-icon-144x144.png"
    />
    <meta name="msapplication-config" content="/favicon/browserconfig.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans antialiased bg-[#151515] text-foreground min-h-screen">
    <slot />

    <script>
      import Lenis from "lenis";

      declare global {
        interface Window {
          __lenis?: Lenis;
        }
      }

      function isMobile() {
        return (
          window.matchMedia("(max-width: 768px)").matches ||
          window.matchMedia("(pointer: coarse)").matches ||
          "ontouchstart" in window
        );
      }

      let rafId: number | null = null;

      function setupSmoothScroll() {
        // Limpiar instancia previa si existe
        if (window.__lenis) {
          if (rafId !== null) {
            cancelAnimationFrame(rafId);
            rafId = null;
          }
          window.__lenis.destroy();
          window.__lenis = undefined;
        }

        // Si es dispositivo móvil o táctil, NO activamos Lenis para evitar lag y mantener rendimiento nativo fluido a 120Hz
        if (isMobile()) {
          return;
        }

        const lenis = new Lenis({
          duration: 1.15,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          touchMultiplier: 1.2,
        });

        window.__lenis = lenis;

        function raf(time: number) {
          if (!window.__lenis) return;
          lenis.raf(time);
          rafId = requestAnimationFrame(raf);
        }
        rafId = requestAnimationFrame(raf);

        // Suavizado premium exclusivo en desktop al hacer clic en enlaces ancla (#inicio, #catalogo, etc.)
        const anchorLinks =
          document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]');
        anchorLinks.forEach((anchor) => {
          anchor.addEventListener("click", (e) => {
            // En móvil dejamos que el navegador navegue nativamente de forma instantánea
            if (isMobile() || !window.__lenis) return;

            const href = anchor.getAttribute("href");
            if (!href || href === "#") return;
            const target = document.querySelector<HTMLElement>(href);
            if (target) {
              e.preventDefault();
              lenis.scrollTo(target, {
                offset: 0,
                duration: 1.0,
                onComplete: () => {
                  target.setAttribute("tabindex", "-1");
                  target.focus({ preventScroll: true });
                },
              });
              if (history.pushState) {
                history.pushState(null, "", href);
              }
            }
          });
        });
      }

      setupSmoothScroll();
      document.addEventListener("astro:page-load", setupSmoothScroll);
      window.addEventListener("resize", () => {
        setupSmoothScroll();
      });
    </script>
  </body>
</html>
